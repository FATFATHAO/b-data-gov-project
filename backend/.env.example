# ============================================================
# B站 API 凭证 (必需)
# ============================================================
# B站登录会话凭证，从浏览器 cookies 获取
BILI_SESSDATA=

# B站 CSRF  token，从 cookies 获取
BILI_BILI_JCT=

# B站设备标识，用于 WBI 签名验证，防止 412 错误
BILI_BUVID3=
BILI_BUVID4=

# ============================================================
# Kafka 配置
# ============================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka Topics
DANMAKU_RAW_TOPIC=danmaku_raw
DANMAKU_AGG_TOPIC=danmaku_agg
DANMAKU_SENTIMENT_TOPIC=danmaku_sentiment
DANMAKU_WORDCLOUD_TOPIC=danmaku_wordcloud

# ============================================================
# Redis 配置
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================================
# 数据库配置
# ============================================================
# PostgreSQL 连接字符串 (用户认证用)
DATABASE_URL=postgresql://bdata:bdata123456@localhost:5432/dbname

# DuckDB 数据库文件路径
DUCKDB_PATH=backend/data/b_data_gov.duckdb

# ============================================================
# Spark 配置
# ============================================================
SPARK_HOME=/opt/spark

# ============================================================
# Collectors 采集器默认配置
# ============================================================
# B站直播间 ID (默认 732 - 罗翔说刑法)
BILI_ROOM_ID=732

# B站视频 BV 号 (用于视频弹幕采集)
BILI_BV_ID=
